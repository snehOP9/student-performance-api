  "buildCommand": "npm --prefix student-performance-predictor-pro run build",
  "outputDirectory": "student-performance-predictor-pro/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
