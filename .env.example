# Backend (FastAPI)
# Comma-separated origins for CORS.
# Include your local Vite app (default: 3000) plus your deployed frontend domain.
FRONTEND_ORIGINS=https://student-performance-predictor-pro-w.vercel.app,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Public frontend URL used in password reset links
FRONTEND_BASE_URL=https://student-performance-predictor-pro-w.vercel.app

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/student_predictor

# JWT config
JWT_SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
TEMP_2FA_TOKEN_EXPIRE_MINUTES=5

# TOTP 2FA issuer label (shown in authenticator apps)
TOTP_ISSUER=StudentPerformancePredictorPro

# Optional social OAuth (configure when ready)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Email provider (Resend)
MAIL_PROVIDER=resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=auth@studentpredictorpro.com

# Local API base URL for development and service integrations
API_BASE=http://127.0.0.1:8000
